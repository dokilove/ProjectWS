.root {
    width: 100%;
    height: 100%;
    position: absolute;
    justify-content: space-between;
    flex-direction: row;
    padding: 10px;
}

.top-left-container {
    align-items: flex-start;
}

.top-right-container {
    align-items: flex-end;
}

.hud-element_time {
    margin-bottom: 5px;
}

.hud-text {
    color: white;
    -unity-font-style: bold;
    font-size: 16px;
}

.hud-title {
    margin-right: 5px;
}

.hud-element {
    margin-bottom: 5px;
}

/* --- Off-screen vehicle indicator (OffscreenVehicleIndicator.cs) --- */
.vehicle-indicator-layer {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.vehicle-indicator {
    position: absolute;
}

.vehicle-indicator__label {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    margin: 0;
    padding: 0;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    font-size: 11px;
    color: white;
}
